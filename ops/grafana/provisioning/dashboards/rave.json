{
  "uid": "rave-sync",
  "title": "Rave — sync health",
  "tags": ["rave"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Live rooms",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "rave-prometheus" }, "refId": "A", "expr": "rave_rooms_live", "legendFormat": "rooms" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Live peers",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "rave-prometheus" }, "refId": "A", "expr": "rave_peers_live", "legendFormat": "peers" }
      ]
    }
  ]
}
