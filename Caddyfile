# Phase 1 is same-wifi, so Caddy issues certs from its own internal CA.
# Let's Encrypt cannot validate a LAN-only host; phase 2 with a real domain
# swaps `tls internal` for automatic HTTPS and removes the device trust step.
#
# Peers reach everything same-origin through here: no mixed content, and
# WebRTC gets the secure context it requires.

{
	auto_https disable_redirects

	# A browser given a bare IP sends no SNI, so Caddy has no server name to
	# pick a certificate by and aborts the handshake — which is what a phone
	# reports as ERR_SSL_PROTOCOL_ERROR. Phase 1 is joined by IP from phones,
	# so naming the default explicitly is what makes the LAN URL reachable
	# at all. Phase 2 has a real domain and real SNI, and this goes away.
	default_sni {$RAVE_HOST:localhost}
}

# Deliberately a catch-all rather than a list of addresses. DHCP moves the
# host's LAN IP, and an explicit list only ever matches the IP that was
# current when the container was recreated — afterwards Caddy matches no site
# and answers an empty 200, which is a blank page on the phone. Matching on
# any host keeps the LAN URL working across a lease change; `tls internal`
# below still needs the specific IP, which is what RAVE_HOST is for.
:443 {
	# on_demand so the internal CA mints a cert for whichever IP the device
	# actually connected to, at handshake time, instead of only the one baked
	# in when the container started. Safe here because this listener is only
	# ever reachable from the LAN. A new IP costs one fresh trust warning.
	tls internal {
		on_demand
	}

	handle /ws* {
		reverse_proxy realtime:8080
	}

	handle /healthz {
		reverse_proxy realtime:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
